# Server Configuration
PORT=3001
SESSION_SECRET=your-secure-session-secret-key-here

# Supabase Database & Realtime Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GitHub App Integration Credentials
GITHUB_APP_ID=your-github-app-id
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
WEBHOOK_URL=http://localhost:3001/api/webhooks/github

# Nebius AI Provider Configuration
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_FAST_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
NEBIUS_REASONING_MODEL=deepseek-ai/DeepSeek-R1
NEBIUS_ULTRA_MODEL=nvidia/nemotron-3-ultra
MAX_AI_REQUESTS_PER_RUN=10
MAX_REPAIR_RETRIES=2
